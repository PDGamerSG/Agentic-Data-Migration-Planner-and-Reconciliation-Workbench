      "css": ".ds-section{background:var(--paper);color:var(--ink);border:1px solid var(--rule);border-radius:10px;font-family:var(--sans)}.ds-head{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:17px 20px;border-bottom:1px solid var(--rule-soft)}.ds-head h2{margin:0;font-size:15px;font-weight:650;letter-spacing:-.01em}.ds-head span{font-size:12px;color:var(--muted)}.ds-body{padding:20px;font-size:14px;line-height:1.6}"
    }
