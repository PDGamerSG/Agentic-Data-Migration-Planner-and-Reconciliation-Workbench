# App: Neon pooled connection. CLI: Neon direct connection.
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/manifest
DIRECT_URL=postgresql://postgres:postgres@localhost:54329/manifest
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/manifest_test
# Optional; without a key the deterministic offline planner runs.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ALLOW_FAULT_INJECTION=true
# Required for public deployments. Protects all pages and API mutations.
APP_ACCESS_CODE=
SESSION_SECRET=

